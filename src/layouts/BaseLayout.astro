---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import { SITE } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  canonicalURL = Astro.url.href,
} = Astro.props;

const canonical = new URL(canonicalURL, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />
    <meta name="keywords" content="desarrollador web, portafolio, frontend, react, astro, Bairon Garita, desarrollo web" />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Spanish" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    {!ogImage && (
      <meta name="twitter:card" content="summary" />
    )}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={SITE.author} />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{SITE.name}",
        "url": "{SITE.url}",
        "jobTitle": "Desarrollador Web",
        "sameAs": [
          "{SITE.social.github}",
          "{SITE.social.linkedin}"
        ],
        "email": "{SITE.email}",
        "description": "{SITE.description}",
        "knowsAbout": ["Desarrollo Web", "Frontend", "React", "Astro", "UI/UX"]
      }
    </script>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <!-- Scroll Progress Bar -->
    <div id="progress-bar" class="scroll-progress-bar"></div>

    <slot />

    <!-- Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-slate-900/80 text-slate-300 shadow-lg opacity-0 translate-y-3 pointer-events-none backdrop-blur-sm transition-all duration-300 hover:border-sky-400/30 hover:bg-sky-500/20 hover:text-white hover:shadow-sky-500/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
      aria-label="Volver arriba"
      tabindex="-1"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script type="module">
      import { animate, inView, stagger, scroll } from "motion";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        // --- Accent hue animation ---
        animate(
          ":root",
          { "--accent-hue": [198, 222, 188, 198] },
          { duration: 18, repeat: Infinity, ease: "linear" }
        );

        // --- Scroll progress bar ---
        const progressBar = document.getElementById("progress-bar");
        if (progressBar) {
          scroll((progress) => {
            progressBar.style.transform = `scaleX(${progress})`;
          });
        }

        // --- Back to top ---
        const backToTop = document.getElementById("back-to-top");
        if (backToTop) {
          const setBackToTopVisible = (visible) => {
            backToTop.classList.toggle("opacity-0", !visible);
            backToTop.classList.toggle("opacity-100", visible);
            backToTop.classList.toggle("translate-y-3", !visible);
            backToTop.classList.toggle("translate-y-0", visible);
            backToTop.classList.toggle("pointer-events-none", !visible);
            backToTop.classList.toggle("pointer-events-auto", visible);
            backToTop.tabIndex = visible ? 0 : -1;
            backToTop.setAttribute("aria-hidden", String(!visible));
          };

          scroll((progress) => {
            setBackToTopVisible(progress > 0.15);
          });

          backToTop.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }

        // --- Orb animations ---
        animate(
          "[data-motion-orb]",
          { x: [0, 12, -8, 0], y: [0, -18, 10, 0], scale: [1, 1.08, 0.98, 1] },
          { duration: 14, repeat: Infinity, ease: "ease-in-out" }
        );

        // --- Hero entrance stagger ---
        animate(
          "[data-motion-hero]",
          { opacity: [0, 1], y: [18, 0], filter: ["blur(8px)", "blur(0px)"] },
          { duration: 0.75, delay: stagger(0.08), ease: "ease-out" }
        );

        // --- Scroll reveal with parallax-like effect ---
        inView("[data-motion-reveal]", (element) => {
          const speed = element.getAttribute("data-speed") || "1";
          const yOffset = 20 * parseFloat(speed);
          animate(
            element,
            { opacity: [0, 1], y: [yOffset, 0], filter: ["blur(8px)", "blur(0px)"] },
            { duration: 0.65, ease: "ease-out" }
          );
        }, { margin: "-80px 0px" });

        // --- Scale in effect for specific elements ---
        inView("[data-motion-scale]", (element) => {
          animate(
            element,
            { opacity: [0, 1], scale: [0.92, 1], filter: ["blur(4px)", "blur(0px)"] },
            { duration: 0.6, ease: [0.16, 1, 0.3, 1] }
          );
        }, { margin: "-60px 0px" });
      }
    </script>
  </body>
</html>
