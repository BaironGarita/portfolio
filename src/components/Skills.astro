---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const skillGroups = [
  {
    title: "Frontend",
    icon: "code" as const,
    accent: "from-cyan-400 to-blue-500",
    skills: ["HTML/CSS", "JavaScript", "TypeScript", "React", "Astro", "Tailwind CSS"],
  },
  {
    title: "Backend",
    icon: "server" as const,
    accent: "from-violet-400 to-purple-500",
    skills: ["Node.js", "PostgreSQL", "REST APIs", "Git", "ASP.NET Core"],
  },
  {
    title: "Herramientas",
    icon: "tools" as const,
    accent: "from-emerald-400 to-teal-500",
    skills: ["VS Code", "Docker", "Linux", "CI/CD"],
  },
];
---

<section id="habilidades" class="section relative overflow-hidden" aria-labelledby="habilidades-heading">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_40%,rgba(56,189,248,0.06),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <SectionHeader
      id="habilidades-heading"
      eyebrow="Stack"
      title="Habilidades"
      description="Tecnologías y herramientas que utilizo para construir interfaces y productos sólidos."
    />

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {
        skillGroups.map((group, index) => (
          <div
            data-motion-reveal
            data-reveal-delay={String(index * 100)}
            class="card card-interactive card-spotlight p-5 sm:p-6"
          >
            <div class="mb-4 flex items-center gap-3" data-reveal-child>
              <div
                class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${group.accent} text-white shadow-md`}
              >
                <Icon name={group.icon} class="h-4 w-4" />
              </div>
              <h3 class="text-sm font-semibold tracking-[0.15em] text-white uppercase">{group.title}</h3>
            </div>

            <ul class="flex flex-wrap gap-2" aria-label={group.title}>
              {group.skills.map((skill) => (
                <li class="chip chip-hover" data-reveal-child>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
