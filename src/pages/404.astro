---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title={`404 — Página no encontrada | ${SITE.name}`}
  description="La página que buscas no existe. Vuelve al inicio del portafolio."
>
  <div class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 py-16">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-[-3rem] left-[-4rem] h-64 w-64 rounded-full bg-cyan-400/10 blur-3xl"></div>
      <div class="absolute right-[-4rem] bottom-[-3rem] h-64 w-64 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div data-motion-reveal class="w-full max-w-md text-center">
      <p
        data-reveal-child
        class="text-gradient-animate float-soft mb-2 bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-7xl font-black tracking-tight text-transparent sm:text-8xl"
        aria-hidden="true"
      >
        404
      </p>
      <h1 data-reveal-child class="sr-only">404 — Página no encontrada</h1>

      <p data-reveal-child class="mb-2 text-lg font-semibold text-white sm:text-xl">
        Página no encontrada
      </p>
      <p data-reveal-child class="mb-8 text-sm leading-relaxed text-slate-400 sm:text-base">
        La ruta a la que intentas acceder no existe o fue movida. Revisa la URL o vuelve al inicio.
      </p>

      <div data-reveal-child class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href={`${import.meta.env.BASE_URL}`} class="btn btn-primary">
          <Icon name="arrowLeft" class="h-4 w-4" />
          Volver al inicio
        </a>
        <a href={`mailto:${SITE.email}`} class="btn btn-secondary">
          Contactar
          <Icon name="arrowRight" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <p class="absolute bottom-6 text-xs text-slate-600 sm:bottom-8">
      &copy; {new Date().getFullYear()} — {SITE.name}
    </p>
  </div>
</BaseLayout>
