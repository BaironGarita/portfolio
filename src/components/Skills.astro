---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";
import { skillGroups } from "../data/skills";
---

<section
  id="habilidades"
  class="section relative"
  aria-labelledby="habilidades-heading"
>
  <div class="container-page">
    <SectionHeader
      id="habilidades-heading"
      index="03"
      eyebrow="Stack"
      title="Herramientas con las que"
      accent="construyo"
      description="Tecnologías y prácticas que utilizo para llevar una idea desde el wireframe hasta producción."
    />

    <div class="grid gap-4 sm:gap-5 md:grid-cols-3">
      {
        skillGroups.map((group, index) => (
          <div
            data-reveal
            data-reveal-delay={String(index * 90)}
            class="panel panel-hover card-spotlight group relative overflow-hidden p-6 sm:p-7"
          >
            <div
              class={`pointer-events-none absolute -top-20 -right-20 h-40 w-40 rounded-full bg-gradient-to-br ${group.accent} opacity-[0.18] blur-3xl transition-opacity duration-500 group-hover:opacity-30`}
              aria-hidden="true"
            />

            <div class="relative mb-6 flex items-center justify-between">
              <div
                class={`flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br ${group.accent} text-white shadow-lg shadow-sky-950/50`}
              >
                <Icon name={group.icon} class="h-5 w-5" />
              </div>
              <span class="font-mono text-[11px] tracking-[0.3em] text-slate-400">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <h3 class="relative text-lg font-semibold tracking-tight text-white">
              {group.title}
            </h3>

            <ul
              class="relative mt-4 flex flex-wrap gap-2"
              aria-label={group.title}
            >
              {group.skills.map((skill) => (
                <li class="chip chip-hover">{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
