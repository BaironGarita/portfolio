---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const experience = [
  {
    role: "Desarrollador Web Freelance",
    company: "Independiente",
    period: "2023 — Presente",
    description:
      "Desarrollo de sitios web y aplicaciones para clientes locales, enfocándome en rendimiento, accesibilidad y diseño moderno.",
  },
  {
    role: "Desarrollador Full-Stack",
    company: "Proyectos académicos",
    period: "2022 — 2023",
    description:
      "Construcción de aplicaciones web completas con stacks como ASP.NET Core, React y PHP, aplicando buenas prácticas de desarrollo.",
  },
];

const education = [
  {
    degree: "Ingeniería en Sistemas",
    school: "Universidad",
    period: "En curso",
    description: "Formación en desarrollo de software, bases de datos, redes y gestión de proyectos tecnológicos.",
  },
];
---

<section id="sobre-mi" class="section" aria-labelledby="about-heading">
  <div class="container-page">
    <SectionHeader
      id="about-heading"
      eyebrow="Sobre mí"
      title="Conóceme un poco más"
      description="Desarrollador web apasionado por crear experiencias digitales que combinan buen diseño con código limpio y funcional."
    />

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Biografía -->
      <div
        data-motion-reveal
        class="card p-6 sm:p-8"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-sky-500/10">
            <Icon name="user" class="h-5 w-5 text-sky-400" />
          </div>
          <h3 class="text-lg font-semibold text-white">Biografía</h3>
        </div>
        <div class="space-y-3 text-sm leading-7 text-slate-300">
          <p>
            Soy <strong class="text-white">Bairon Garita</strong>, desarrollador web de Costa Rica con experiencia
            en la creación de sitios y aplicaciones web modernas. Me enfoco en construir interfaces limpias,
            accesibles y de alto rendimiento.
          </p>
          <p>
            Mi stack principal incluye tecnologías como <strong class="text-white">React</strong>,
            <strong class="text-white">Astro</strong>, <strong class="text-white">Tailwind CSS</strong>,
            <strong class="text-white">ASP.NET Core</strong> y <strong class="text-white">PHP</strong>,
            aunque siempre estoy abierto a aprender nuevas herramientas y mejorar mis habilidades.
          </p>
          <p>
            Cuando no estoy programando, me gusta explorar nuevas tecnologías, contribuir a proyectos
            de código abierto y compartir conocimiento con la comunidad.
          </p>
        </div>
      </div>

      <!-- Educación -->
      <div
        data-motion-reveal
        data-reveal-delay="90"
        class="card p-6 sm:p-8"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10">
            <Icon name="book" class="h-5 w-5 text-violet-400" />
          </div>
          <h3 class="text-lg font-semibold text-white">Educación</h3>
        </div>
        <div class="space-y-4">
          {education.map((item) => (
            <div>
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="text-sm font-medium text-white">{item.degree}</p>
                  <p class="text-sm text-slate-400">{item.school}</p>
                </div>
                <span class="chip tabular-nums text-slate-400 shrink-0">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-slate-300">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Experiencia -->
    <div
      data-motion-reveal
      data-reveal-delay="180"
      class="mt-6 card p-6 sm:p-8"
    >
      <div class="flex items-center gap-3 mb-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10">
          <Icon name="briefcase" class="h-5 w-5 text-emerald-400" />
        </div>
        <h3 class="text-lg font-semibold text-white">Experiencia</h3>
      </div>
      <div class="space-y-6">
        {experience.map((item, index) => (
          <div class="relative pl-6 before:absolute before:left-1.5 before:top-2 before:h-full before:w-px before:bg-slate-700">
            <div class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-emerald-400 ring-4 ring-slate-950" />
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div>
                <p class="text-sm font-medium text-white">{item.role}</p>
                <p class="text-sm text-sky-400">{item.company}</p>
              </div>
              <span class="chip tabular-nums text-slate-400 mt-1 shrink-0 sm:mt-0">{item.period}</span>
            </div>
            <p class="mt-2 text-sm text-slate-300">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
