---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-sky-500 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-slate-950 focus:shadow-lg focus:outline-none"
>
  Saltar al contenido
</a>

<header
  id="header"
  class="fixed top-0 right-0 left-0 z-50 border-b border-transparent bg-slate-950/40 pt-[env(safe-area-inset-top)] backdrop-blur-xl transition-[background-color,border-color,box-shadow,transform] duration-300"
  data-scrolled="false"
>
  <nav class="container-page flex h-16 items-center justify-between" aria-label="Principal">
    <a
      href="#hero"
      class="text-base font-semibold tracking-tight sm:text-lg"
      aria-label={`${SITE.name} — Inicio`}
    >
      Bairon<span class="bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-transparent"
        >.Dev</span
      >
    </a>

    <ul class="hidden items-center gap-1 rounded-full border border-slate-800/70 bg-white/[0.03] p-1 md:flex">
      {
        SITE.nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link={item.href}
              class="nav-link inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="#contacto" class="btn btn-primary hidden sm:inline-flex">Contactar</a>

      <button
        id="menu-toggle"
        type="button"
        class="btn btn-ghost btn-icon md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" id="menu-open-icon" class="h-5 w-5" />
        <Icon name="close" id="menu-close-icon" class="hidden h-5 w-5" />
      </button>
    </div>
  </nav>
</header>

<!-- Mobile drawer — lives OUTSIDE <header>: backdrop-filter/transform on the header
     would make it the containing block for position:fixed and trap the menu. -->
<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-[60] hidden md:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div
    id="menu-overlay"
    class="absolute inset-0 bg-slate-950/80 opacity-0 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>

  <div
    id="menu-panel"
    class="absolute top-0 right-0 flex h-full w-[min(18rem,85vw)] translate-x-full flex-col border-l border-slate-700/70 bg-slate-900/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out"
  >
    <div
      class="flex items-center justify-between border-b border-slate-800/60 px-5 pt-[calc(1rem+env(safe-area-inset-top))] pb-4"
    >
      <a
        href="#hero"
        class="menu-link text-base font-semibold text-white"
        aria-label={`${SITE.name} — Inicio`}
      >
        Bairon<span
          class="bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-transparent"
          >.Dev</span
        >
      </a>
      <button id="menu-close" type="button" class="btn btn-ghost btn-icon" aria-label="Cerrar menú">
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto overscroll-contain px-5 py-5" aria-label="Móvil">
      <ul class="flex flex-col gap-1">
        {
          SITE.nav.map((item, index) => (
            <li>
              <a
                href={item.href}
                data-nav-link={item.href}
                style={`--menu-delay: ${90 + index * 45}ms`}
                class="menu-link nav-link flex w-full items-center rounded-xl px-4 py-3 text-base font-medium text-slate-300 hover:bg-white/10 hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex gap-2 border-t border-slate-800/60 pt-5" style="--menu-delay: 300ms">
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="menu-link btn btn-ghost btn-icon"
          aria-label="GitHub"
        >
          <Icon name="github" class="h-4 w-4" />
        </a>
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="menu-link btn btn-ghost btn-icon"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" class="h-4 w-4" />
        </a>
      </div>
    </nav>

    <div
      class="border-t border-slate-800/60 px-5 pt-4 pb-[calc(1rem+env(safe-area-inset-bottom))]"
      style="--menu-delay: 345ms"
    >
      <a href="#contacto" class="menu-link btn btn-primary btn-block">Contactar</a>
    </div>
  </div>
</div>

<style>
  .nav-link.is-active {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.25);
  }

  /* Drawer items: staggered entrance (delay lives in the OPEN state, so closing is instant) */
  #mobile-menu .menu-link {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  #mobile-menu.is-open .menu-link {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--menu-delay, 0ms);
  }

  #header[data-scrolled="true"] {
    border-color: rgba(30, 41, 59, 0.7);
    background-color: rgba(2, 6, 23, 0.88);
    box-shadow: 0 10px 40px -20px rgba(0, 0, 0, 0.5);
  }

  #header[data-hidden="true"] {
    transform: translateY(-100%);
  }
</style>

<script data-astro-rerun>
  (() => {
    const header = document.getElementById("header");
    const toggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("menu-overlay");
    const panel = document.getElementById("menu-panel");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");
    const closeButton = document.getElementById("menu-close");
    const menuLinks = document.querySelectorAll(".menu-link");
    const navLinks = document.querySelectorAll("[data-nav-link]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    // — Scroll state: scrolled styling + hide-on-scroll-down (bound once) —
    if (!window.__headerScrollBound) {
      window.__headerScrollBound = true;
      let lastY = window.scrollY;

      const onScroll = () => {
        const el = document.getElementById("header");
        if (!el) return;
        const y = window.scrollY;
        el.dataset.scrolled = String(y > 24);
        if (window.__menuOpen || y < 220) {
          el.dataset.hidden = "false";
        } else if (y > lastY + 6) {
          el.dataset.hidden = "true";
        } else if (y < lastY - 6) {
          el.dataset.hidden = "false";
        }
        lastY = y;
      };

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    } else if (header) {
      // Fresh header after navigation: sync with current scroll state
      header.dataset.scrolled = String(window.scrollY > 24);
      header.dataset.hidden = window.__menuOpen || window.scrollY < 220 ? "false" : "true";
    }

    // — Document-level listeners bound once (delegate to the fresh DOM) —
    if (!window.__menuDocBound) {
      window.__menuDocBound = true;

      document.addEventListener("keydown", (e) => {
        if (!window.__menuOpen) return;
        if (e.key === "Escape") {
          document.getElementById("menu-close")?.click();
          return;
        }
        if (e.key === "Tab") {
          const panel = document.getElementById("menu-panel");
          if (!panel) return;
          const focusables = Array.from(panel.querySelectorAll(FOCUSABLE)).filter(
            (el) => el.offsetParent !== null,
          );
          if (!focusables.length) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      window.addEventListener("resize", () => {
        // Delegate to the fresh close button so the current run's handler closes the menu
        if (window.innerWidth >= 768 && window.__menuOpen) {
          document.getElementById("menu-close")?.click();
        }
      });
    }

    // — Active section highlight (re-created per page view) —
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.getAttribute("data-nav-link")?.replace("#", "") || ""))
      .filter(Boolean);

    function setActiveNav(activeId) {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("data-nav-link") === `#${activeId}`;
        link.classList.toggle("is-active", isActive);
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    }

    if (sections.length && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]) setActiveNav(visible[0].target.id);
        },
        { rootMargin: "-20% 0px -55% 0px", threshold: [0, 0.25, 0.5] },
      );
      sections.forEach((s) => observer.observe(s));
    }

    // — Mobile menu (CSS transitions) —
    let closeTimer = 0;

    function openMenu() {
      if (!mobileMenu || !toggle) return;
      window.clearTimeout(closeTimer);
      window.__menuOpen = true;
      mobileMenu.classList.remove("hidden", "pointer-events-none");
      mobileMenu.classList.add("pointer-events-auto");
      mobileMenu.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      openIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      if (header) header.dataset.hidden = "false";
      overlay?.classList.remove("opacity-0");
      panel?.classList.remove("translate-x-full");
      // Two frames so the closed state paints first; then items stagger in
      requestAnimationFrame(() => requestAnimationFrame(() => mobileMenu.classList.add("is-open")));
      closeButton?.focus();
    }

    function closeMenu() {
      if (!mobileMenu || !toggle || !window.__menuOpen) return;
      mobileMenu.classList.remove("is-open");

      const finish = () => {
        mobileMenu.classList.add("pointer-events-none", "hidden");
        mobileMenu.classList.remove("pointer-events-auto");
        mobileMenu.setAttribute("aria-hidden", "true");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
        window.__menuOpen = false;
        toggle.focus();
      };

      if (reduceMotion) {
        overlay?.classList.add("opacity-0");
        panel?.classList.add("translate-x-full");
        finish();
        return;
      }

      overlay?.classList.add("opacity-0");
      panel?.classList.add("translate-x-full");
      closeTimer = window.setTimeout(finish, 300);
    }

    toggle?.addEventListener("click", () => (window.__menuOpen ? closeMenu() : openMenu()));
    closeButton?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);
    menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

    // Swipe-right to close (simple threshold, no live drag)
    let touchX = 0;
    panel?.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches.length === 1) touchX = e.touches[0].clientX;
      },
      { passive: true },
    );
    panel?.addEventListener(
      "touchend",
      (e) => {
        if (!window.__menuOpen) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (dx > 80) closeMenu();
      },
      { passive: true },
    );
  })();
</script>
