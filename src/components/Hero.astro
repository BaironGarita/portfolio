---
import { SITE } from "../site.config";
---

<section id="hero" class="relative overflow-hidden pt-[calc(6rem+env(safe-area-inset-top))] sm:pt-28" aria-labelledby="hero-heading">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div data-motion-orb class="absolute left-[-8rem] top-16 h-72 w-72 rounded-full bg-cyan-400/15 blur-3xl"></div>
    <div data-motion-orb class="absolute right-0 top-0 h-96 w-96 rounded-full bg-blue-500/15 blur-3xl"></div>
    <div data-motion-orb class="absolute bottom-[-6rem] left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-slate-300/10 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-14 px-4 pb-20 sm:px-6 lg:grid-cols-[1.25fr_.75fr] lg:items-center lg:py-20">
    <div class="max-w-2xl">
      <p data-motion-hero class="mb-5 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-white/5 px-4 py-2 text-sm font-medium text-sky-200 shadow-sm backdrop-blur">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_0_6px_rgba(74,222,128,0.16)]"></span>
        </span>
        Disponible para colaborar
      </p>

      <h1 id="hero-heading" data-motion-hero class="mb-6 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Interfaces limpias,
        <span class="block bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-transparent">
          <span id="typing-text" aria-live="polite">experiencias fluidas.</span>
          <span id="typing-cursor" class="inline-block h-[0.9em] w-[0.08em] animate-pulse bg-cyan-300 align-[-0.1em]" aria-hidden="true"></span>
        </span>
      </h1>

      <p data-motion-hero class="mb-8 max-w-xl text-lg leading-8 text-slate-300">
        Soy <strong class="font-semibold text-white">{SITE.name}</strong>, desarrollador web enfocado en crear productos visualmente
        sólidos, fáciles de usar y mantenibles a largo plazo.
      </p>

      <div data-motion-hero class="flex flex-wrap items-center gap-3">
        <a
          href="#proyectos"
          class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-600 px-5 py-3 text-sm font-medium text-slate-950 shadow-lg shadow-cyan-500/20 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-cyan-400/30"
        >
          Ver proyectos
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full border border-slate-700/70 bg-white/5 px-5 py-3 text-sm font-medium text-slate-200 backdrop-blur transition-all duration-300 hover:border-sky-400/30 hover:bg-white/10 hover:text-white"
        >
          Hablar de un proyecto
        </a>
        <div class="flex items-center gap-2 pl-1">
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-white/5 text-slate-300 transition-all duration-300 hover:border-sky-400/30 hover:bg-white/10 hover:text-white"
            aria-label="GitHub de Bairon Garita"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-white/5 text-slate-300 transition-all duration-300 hover:border-sky-400/30 hover:bg-white/10 hover:text-white"
            aria-label="LinkedIn de Bairon Garita"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <aside data-motion-hero class="group relative rounded-3xl border border-slate-700/70 bg-white/5 p-6 shadow-[0_20px_60px_-30px_rgba(2,6,23,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-sky-400/20 hover:bg-white/[0.06]" aria-label="Resumen del perfil">
      <div class="absolute inset-0 -z-10 rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(circle at 50% 0%, rgba(56,189,248,0.15), transparent 70%);" aria-hidden="true"></div>

      <div class="mb-6 flex items-center justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-slate-400">Perfil</p>
          <h2 class="text-xl font-semibold text-white">Diseño + desarrollo</h2>
        </div>
        <span class="shrink-0 rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-emerald-400/20">
          UX focused
        </span>
      </div>

      <ul class="space-y-3">
        <li class="rounded-2xl border border-sky-400/10 bg-white/5 p-4 transition-all duration-300 hover:bg-white/[0.08]">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Enfoque</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">Interfaces claras, navegación simple y jerarquía visual sólida.</p>
        </li>
        <li class="rounded-2xl border border-cyan-400/10 bg-white/5 p-4 transition-all duration-300 hover:bg-white/[0.08]">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">Valor</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">Componentes consistentes y soluciones pensadas para crecer.</p>
        </li>
        <li class="rounded-2xl border border-fuchsia-400/10 bg-white/5 p-4 transition-all duration-300 hover:bg-white/[0.08]">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-fuchsia-300">Contacto</p>
          <a class="mt-1 inline-flex text-sm font-medium text-sky-300 transition-colors hover:text-white" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </li>
      </ul>
    </aside>
  </div>

  <!-- Scroll hint -->
  <div class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 sm:block" aria-hidden="true">
    <a href="#proyectos" class="pointer-events-auto flex flex-col items-center gap-2 text-slate-500 transition-colors hover:text-slate-300" aria-label="Ir a proyectos">
      <span class="text-[10px] font-semibold uppercase tracking-[0.25em]">Scroll</span>
      <span class="flex h-8 w-5 items-start justify-center rounded-full border border-slate-600/60 p-1">
        <span class="h-1.5 w-1.5 animate-bounce rounded-full bg-sky-400"></span>
      </span>
    </a>
  </div>
</section>

<script>
  const phrases = [
    "experiencias fluidas.",
    "código mantenible.",
    "rendimiento real.",
    "diseño accesible.",
    "resultados sólidos.",
  ];

  const textEl = document.getElementById("typing-text");
  const cursorEl = document.getElementById("typing-cursor");
  if (!textEl || !cursorEl) throw new Error("Typing elements not found");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Static first phrase if user prefers reduced motion
  if (reduceMotion) {
    textEl.textContent = phrases[0];
    cursorEl.classList.add("hidden");
  } else {
    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let isPaused = false;

    const TYPE_SPEED = 55;
    const DELETE_SPEED = 30;
    const PAUSE_BEFORE_DELETE = 2000;
    const PAUSE_BEFORE_TYPE = 300;

    // Start empty for typewriter entrance
    textEl.textContent = "";

    function typeLoop() {
      const currentPhrase = phrases[phraseIndex];

      if (isPaused) return;

      if (!isDeleting) {
        if (charIndex < currentPhrase.length) {
          charIndex++;
          textEl.textContent = currentPhrase.substring(0, charIndex);
          setTimeout(typeLoop, TYPE_SPEED + Math.random() * 30);
        } else {
          isPaused = true;
          setTimeout(() => {
            isPaused = false;
            isDeleting = true;
            typeLoop();
          }, PAUSE_BEFORE_DELETE);
        }
      } else {
        if (charIndex > 0) {
          charIndex--;
          textEl.textContent = currentPhrase.substring(0, charIndex);
          setTimeout(typeLoop, DELETE_SPEED);
        } else {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          isPaused = true;
          setTimeout(() => {
            isPaused = false;
            typeLoop();
          }, PAUSE_BEFORE_TYPE);
        }
      }
    }

    setTimeout(typeLoop, 1200);
  }
</script>
