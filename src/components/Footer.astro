---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer transition:persist class="border-t border-slate-800/70 bg-slate-950/40" role="contentinfo">
  <div class="container-page py-8 sm:py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xs">
        <a href="#hero" class="text-base font-semibold tracking-tight text-white">
          Bairon<span class="text-gradient-animate bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-transparent"
            >.Dev</span
          >
        </a>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Desarrollador web enfocado en interfaces limpias y experiencias útiles.
        </p>
      </div>

      <nav aria-label="Pie de página">
        <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-slate-500 uppercase">Navegación</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            SITE.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="link-underline inline-flex min-h-0 items-center text-sm text-slate-400 hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-slate-500 uppercase">Conectar</p>
        <div class="flex gap-2">
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label="GitHub"
          >
            <Icon name="github" class="h-4 w-4" />
          </a>
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" class="h-4 w-4" />
          </a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost btn-icon" aria-label="Email">
            <Icon name="mail" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-slate-800/60 pt-5 sm:mt-10 sm:flex-row sm:items-center sm:justify-between sm:pt-6">
      <p class="text-sm text-slate-500">&copy; {year} — {SITE.name}. Construido con Astro.</p>
      <a
        href="#hero"
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-white"
      >
        Volver arriba
        <Icon
          name="chevronUp"
          class="h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</footer>
