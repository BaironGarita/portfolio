---
const projects = [
  {
    title: "SpCarrillos",
    summary:
      "Sitio web para una iglesia local en Carrillos, Poás. Arquitectura limpia, rendimiento en producción y una experiencia clara para la comunidad.",
    tags: ["HTML5", "JavaScript", "Tailwind CSS", "Alpine.js"],
    demo: "https://BaironGarita.github.io/SpCarrillos",
    github: "https://github.com/BaironGarita/SpCarrillos",
    accent: "from-cyan-400 to-sky-500",
    status: "live",
  },
  {
    title: "LYM (Look Your Mood)",
    summary:
      "E-commerce de moda y accesorios con productos personalizables. Enfocado en expresar personalidad a través de una experiencia de compra moderna.",
    tags: ["PHP", "React", "MySQL", "JavaScript", "Tailwind CSS"],
    demo: null,
    github: "https://github.com/BaironGarita/LYM",
    accent: "from-violet-400 to-fuchsia-500",
    status: "code",
  },
  {
    title: "TechDrop",
    summary:
      "Plataforma de subastas en tiempo real inspirada en eBay: autenticación robusta, pujas en vivo con SignalR y gestión segura de cuentas.",
    tags: ["C#", "ASP.NET Core", "SQL Server", "JavaScript", "Bootstrap", "SignalR"],
    demo: null,
    github: "https://github.com/BaironGarita/TechDrop",
    accent: "from-emerald-400 to-teal-500",
    status: "code",
  },
];
---

<section id="proyectos" class="py-24 sm:py-28" aria-labelledby="proyectos-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-motion-reveal class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Portafolio</p>
      <h2 id="proyectos-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Proyectos destacados
      </h2>
      <p class="mt-3 text-base leading-relaxed text-slate-300 sm:text-lg">
        Una selección de trabajos con foco en claridad visual, funcionalidad y experiencia de uso.
      </p>
    </div>

    <div class="grid gap-5 sm:gap-6">
      {
        projects.map((project, index) => (
          <article
            data-motion-reveal
            data-speed={1 + index * 0.1}
            class="group relative overflow-hidden rounded-3xl border border-slate-700/70 bg-white/[0.03] p-6 shadow-sm shadow-slate-950/20 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/30 hover:bg-white/[0.06] hover:shadow-xl hover:shadow-sky-500/5 sm:p-8"
          >
            {/* Accent bar */}
            <div
              class={`absolute left-0 top-0 h-full w-1 bg-gradient-to-b ${project.accent} opacity-60 transition-opacity duration-300 group-hover:opacity-100`}
              aria-hidden="true"
            />

            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
              <div class="min-w-0 flex-1">
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-white/5 px-3 py-1 text-xs font-semibold tabular-nums text-slate-400 ring-1 ring-white/10">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {project.status === "live" ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-emerald-400/20">
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400" />
                      </span>
                      En vivo
                    </span>
                  ) : (
                    <span class="inline-flex items-center rounded-full bg-slate-400/10 px-3 py-1 text-xs font-semibold text-slate-400 ring-1 ring-slate-500/20">
                      Código abierto
                    </span>
                  )}
                </div>

                <h3 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">
                  {project.title}
                </h3>

                <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
                  {project.summary}
                </p>

                <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.title}`}>
                  {project.tags.map((tag) => (
                    <li class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-slate-300 ring-1 ring-white/10 transition-colors group-hover:ring-white/15">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>

              {/* Actions */}
              <div class="flex shrink-0 flex-wrap items-center gap-2 lg:flex-col lg:items-stretch lg:pt-1">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-600 px-5 py-2.5 text-sm font-medium text-slate-950 shadow-lg shadow-cyan-500/15 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-cyan-400/25"
                  >
                    Ver demo
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-700/70 bg-white/5 px-5 py-2.5 text-sm font-medium text-slate-200 transition-all duration-300 hover:border-sky-400/30 hover:bg-white/10 hover:text-white"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  Código
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
