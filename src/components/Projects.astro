---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    summary: entry.data.description,
    tags: entry.data.stack,
    demo: entry.data.url ?? null,
    repo: entry.data.repo ?? null,
    accent: entry.data.accent,
    status: entry.data.status,
  }));
---

<section id="proyectos" class="section" aria-labelledby="proyectos-heading">
  <div class="container-page">
    <SectionHeader
      id="proyectos-heading"
      index="02"
      eyebrow="Portafolio"
      title="Proyectos que"
      accent="salen a producción"
      description="Una selección de trabajos con foco en claridad visual, accesibilidad y rendimiento. Cada uno incluye su caso de estudio completo."
    />

    <div class="space-y-5 sm:space-y-6">
      {
        projects.map((project, index) => {
          const flipped = index % 2 === 1;
          return (
            <article
              data-reveal
              data-reveal-delay={String(index * 80)}
              class="panel panel-hover group relative overflow-hidden"
            >
              <div class="grid lg:grid-cols-[0.92fr_1.08fr]">
                {/* Portada generada en CSS */}
                <div
                  class:list={[
                    "relative min-h-[220px] overflow-hidden border-white/10 sm:min-h-[260px]",
                    flipped
                      ? "order-1 border-b lg:order-2 lg:border-b-0 lg:border-l"
                      : "order-1 border-b lg:border-b-0 lg:border-r",
                  ]}
                  aria-hidden="true"
                >
                  <div
                    class={`absolute inset-0 bg-gradient-to-br ${project.accent} opacity-[0.22]`}
                  />
                  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] bg-[size:34px_34px] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,black,transparent)]" />
                  <div class="absolute -top-10 -right-6 h-40 w-40 rounded-full bg-white/10 blur-3xl" />

                  <span class="cover-initial absolute inset-0 flex items-center justify-center font-serif text-[7rem] leading-none select-none sm:text-[9rem]">
                    {project.title.charAt(0)}
                  </span>

                  <span class="absolute top-4 left-5 font-mono text-[11px] tracking-[0.3em] text-white/55">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="absolute right-5 bottom-4 font-mono text-[11px] tracking-[0.2em] text-white/45 uppercase">
                    caso de estudio
                  </span>
                </div>

                {/* Contenido */}
                <div class="flex flex-col p-6 sm:p-8 lg:p-10">
                  <div class="mb-4 flex flex-wrap items-center gap-2">
                    {project.status === "live" ? (
                      <span class="chip chip-live">
                        <span
                          class="relative flex h-1.5 w-1.5"
                          aria-hidden="true"
                        >
                          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-75" />
                          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mint" />
                        </span>
                        En vivo
                      </span>
                    ) : (
                      <span class="chip chip-muted">Código abierto</span>
                    )}
                    {project.tags.slice(0, 1).map((tag) => (
                      <span class="chip">{tag}</span>
                    ))}
                  </div>

                  <h3 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                    <a
                      href={`${base}proyectos/${project.id}/`}
                      class="transition-colors hover:text-sky"
                    >
                      {project.title}
                      <span class="absolute inset-0 z-10" aria-hidden="true" />
                    </a>
                  </h3>

                  <p class="mt-3 line-clamp-3 text-sm leading-7 text-slate-300 sm:text-base">
                    {project.summary}
                  </p>

                  <ul
                    class="mt-5 flex flex-wrap gap-2"
                    aria-label={`Tecnologías de ${project.title}`}
                  >
                    {project.tags.map((tag) => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>

                  <div class="mt-6 flex flex-wrap items-center gap-3 sm:mt-auto sm:pt-7">
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-sky transition-colors group-hover:text-white">
                      Ver el caso de estudio
                      <Icon name="arrowRight" class="icon-nudge h-4 w-4" />
                    </span>

                    <span class="ml-auto flex items-center gap-2">
                      {project.demo && (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="relative z-20 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wider text-slate-400 uppercase transition-colors hover:text-sky"
                        >
                          Sitio
                          <Icon name="external" class="h-3.5 w-3.5" />
                          <span class="sr-only">
                            {" "}
                            (se abre en una pestaña nueva)
                          </span>
                        </a>
                      )}
                      {project.repo && (
                        <a
                          href={project.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="relative z-20 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wider text-slate-400 uppercase transition-colors hover:text-sky"
                        >
                          <Icon name="github" class="h-3.5 w-3.5" />
                          Código
                          <span class="sr-only">
                            {" "}
                            (se abre en una pestaña nueva)
                          </span>
                        </a>
                      )}
                    </span>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .cover-initial {
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.3);
    transition:
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      -webkit-text-stroke-color 400ms ease;
  }

  article:hover .cover-initial {
    transform: scale(1.06) rotate(-2deg);
    -webkit-text-stroke-color: rgb(255 255 255 / 0.5);
  }
</style>
