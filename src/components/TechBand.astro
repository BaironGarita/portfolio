---
const technologies = [
  "HTML5",
  "CSS",
  "JavaScript",
  "TypeScript",
  "React",
  "Astro",
  "Tailwind CSS",
  "Node.js",
  "PHP",
  "C#",
  "ASP.NET Core",
  "PostgreSQL",
  "MySQL",
  "SQL Server",
  "Docker",
  "Git",
];
---

<section class="tech-band border-y border-white/5 bg-slate-950/45" aria-label="Tecnologías utilizadas">
  <div class="container-page overflow-hidden py-5 sm:py-6">
    <div class="flex items-center gap-5 sm:gap-8">
      <p class="shrink-0 text-xs font-semibold tracking-[0.2em] text-sky-300 uppercase">Tecnologías</p>
      <div class="min-w-0 overflow-hidden" aria-hidden="true">
        <div class="tech-band-track">
          {
            [...technologies, ...technologies].map((technology, index) => (
              <span class="tech-band-item" aria-hidden={index >= technologies.length}>{technology}</span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-band-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.75rem;
    animation: tech-band-scroll 32s linear infinite;
    will-change: transform;
  }

  .tech-band-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid rgb(125 211 252 / 0.14);
    border-radius: 9999px;
    padding: 0.45rem 0.8rem;
    color: rgb(203 213 225 / 0.9);
    background: rgb(255 255 255 / 0.035);
    font-size: 0.8rem;
    line-height: 1;
  }

  @keyframes tech-band-scroll {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-band-track {
      animation: none;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tech-band-item:nth-child(n + 17) {
      display: none;
    }
  }
</style>
