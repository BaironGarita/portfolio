---
import "../styles/global.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/inter/latin-800.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../site.config";
import Icon from "../components/Icon.astro";
import serifFontUrl from "../assets/fonts/instrument-serif-latin.woff2?url";

interface Props {
  /** Título completo de la página. */
  title?: string;
  description?: string;
  /** Ruta relativa a `base` de la imagen social (1200×630). */
  image?: string;
  /** `article` para entradas de blog y casos de estudio. */
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.ogImage,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://example.com");
const canonical = new URL(Astro.url.pathname, site).href;
const absolute = (path: string) =>
  new URL(`${base}${path.replace(/^\//, "")}`, site).href;
const ogImage = absolute(image);
const ogImageAlt = `${SITE.name} — ${SITE.jobTitle}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.origin}#person`,
      name: SITE.name,
      url: new URL(base, site).href,
      jobTitle: SITE.jobTitle,
      email: `mailto:${SITE.email}`,
      description: SITE.description,
      sameAs: [SITE.social.github, SITE.social.linkedin],
      knowsAbout: SITE.knowsAbout,
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}#website`,
      url: new URL(base, site).href,
      name: SITE.name,
      description: SITE.description,
      inLanguage: "es-CR",
      publisher: { "@id": `${site.origin}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link
      rel="icon"
      type="image/x-icon"
      href={`${base}favicon.ico`}
      sizes="any"
    />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link
      rel="preload"
      href={serifFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="author" content={SITE.author} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large"}
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />
  </head>
  <body class="text-paper antialiased">
    <div class="page-bg" aria-hidden="true">
      <div class="page-grid"></div>
      <div class="aurora aurora-1" data-orb></div>
      <div class="aurora aurora-2" data-orb></div>
      <div class="aurora aurora-3"></div>
    </div>

    <div
      id="progress-bar"
      transition:persist
      class="scroll-progress-bar"
      aria-hidden="true"
    >
    </div>

    <slot />

    <button
      id="back-to-top"
      transition:persist
      type="button"
      class="btn btn-ghost btn-icon fixed right-[calc(1rem+env(safe-area-inset-right))] bottom-[calc(1rem+env(safe-area-inset-bottom))] z-50 pointer-events-none translate-y-2 opacity-0 shadow-lg backdrop-blur-sm sm:right-[calc(1.5rem+env(safe-area-inset-right))] sm:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
      aria-label="Volver arriba"
      aria-hidden="true"
      tabindex="-1"
    >
      <Icon name="chevronUp" class="h-5 w-5" />
    </button>

    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      function revealNow(el: Element) {
        const delay = Number(el.getAttribute("data-reveal-delay")) || 0;
        (el as HTMLElement).style.transitionDelay = `${delay}ms`;
        el.querySelectorAll("[data-reveal-child]").forEach((child, i) => {
          (child as HTMLElement).style.transitionDelay =
            `${delay + 80 + i * 55}ms`;
        });
        el.classList.add("is-visible");
      }

      /** Reveal on scroll with a single IntersectionObserver per page view. */
      function initReveals() {
        const targets = document.querySelectorAll(
          "[data-reveal]:not(.is-visible)",
        );

        // Above-the-fold hero content animates on load, staggered.
        document
          .querySelectorAll("[data-reveal-hero]:not(.is-visible)")
          .forEach((el, i) => {
            const delay = reduceMotion ? 0 : i * 70;
            (el as HTMLElement).style.transitionDelay = `${delay}ms`;
            window.setTimeout(() => el.classList.add("is-visible"), delay);
          });

        if (reduceMotion || !("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              revealNow(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -40px" },
        );

        targets.forEach((el) => observer.observe(el));
      }

      let frame = 0;
      function updateScrollState() {
        if (!reduceMotion) {
          const y = window.scrollY;
          if (y < window.innerHeight * 1.5) {
            document.querySelectorAll("[data-orb]").forEach((orb, i) => {
              (orb as HTMLElement).style.translate =
                `0 ${Math.round(y * (i % 2 ? -0.05 : 0.08))}px`;
            });
          }
        }

        const bar = document.getElementById("progress-bar");
        if (bar) {
          const max =
            document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
        }

        const btn = document.getElementById("back-to-top");
        if (btn) {
          const visible = window.scrollY > 400;
          for (const token of [
            "opacity-0",
            "translate-y-2",
            "pointer-events-none",
          ]) {
            btn.classList.toggle(token, !visible);
          }
          for (const token of [
            "opacity-100",
            "translate-y-0",
            "pointer-events-auto",
          ]) {
            btn.classList.toggle(token, visible);
          }
          btn.tabIndex = visible ? 0 : -1;
          btn.setAttribute("aria-hidden", String(!visible));
        }
      }

      function onScroll() {
        if (frame) return;
        frame = window.requestAnimationFrame(() => {
          frame = 0;
          updateScrollState();
        });
      }

      let bound = false;
      function initPage() {
        if (!bound) {
          bound = true;
          window.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", onScroll, { passive: true });

          document.addEventListener("click", (event) => {
            const target = event.target as Element | null;
            if (!target?.closest("#back-to-top")) return;
            window.scrollTo({
              top: 0,
              behavior: reduceMotion ? "auto" : "smooth",
            });
          });

          if (
            !reduceMotion &&
            window.matchMedia("(hover: hover) and (pointer: fine)").matches
          ) {
            document.addEventListener(
              "pointermove",
              (event) => {
                const card = (
                  event.target as Element | null
                )?.closest<HTMLElement>(".card-spotlight");
                if (!card) return;
                const rect = card.getBoundingClientRect();
                card.style.setProperty(
                  "--spot-x",
                  `${event.clientX - rect.left}px`,
                );
                card.style.setProperty(
                  "--spot-y",
                  `${event.clientY - rect.top}px`,
                );
              },
              { passive: true },
            );
          }
        }

        initReveals();
        onScroll();
      }

      document.addEventListener("astro:page-load", initPage);
    </script>
  </body>
</html>
