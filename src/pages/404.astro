---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../site.config";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`404 — Página no encontrada | ${SITE.name}`}
  description="La página que buscas no existe. Vuelve al inicio del portafolio."
  noindex
>
  <main
    id="main-content"
    class="relative flex min-h-dvh flex-col items-center justify-center px-4 py-16"
  >
    <div data-reveal class="w-full max-w-lg text-center">
      <p data-reveal-child class="eyebrow justify-center">Error 404</p>

      <p
        data-reveal-child
        class="serif-accent gradient-text float-soft mt-2 text-[7rem] leading-[0.8] select-none sm:text-[10rem]"
        aria-hidden="true"
      >
        404
      </p>
      <h1 data-reveal-child class="display-lg mt-4 text-white">
        Esta página no existe.
      </h1>

      <p
        data-reveal-child
        class="mx-auto mt-4 max-w-md text-sm leading-7 text-slate-300 sm:text-base"
      >
        La ruta que buscas cambió de lugar o nunca existió. Puedes volver al
        inicio o escribirme directamente.
      </p>

      <div
        data-reveal-child
        class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center"
      >
        <a href={base} class="btn btn-primary w-full sm:w-auto">
          <Icon name="arrowLeft" class="h-4 w-4" />
          Volver al inicio
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="btn btn-secondary w-full sm:w-auto"
        >
          Contactar
          <Icon name="arrowRight" class="icon-nudge h-4 w-4" />
        </a>
      </div>
    </div>

    <p
      class="absolute bottom-6 font-mono text-[11px] tracking-[0.2em] text-slate-400 uppercase sm:bottom-8"
    >
      {new Date().getFullYear()} — {SITE.name}
    </p>
  </main>
</BaseLayout>
