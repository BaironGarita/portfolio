---
const skillGroups = [
  {
    title: "Frontend",
    icon: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    color: "from-cyan-400 to-blue-500",
    glowColor: "rgba(34,211,238,0.15)",
    skills: [
      { name: "HTML/CSS", icon: "🌐" },
      { name: "JavaScript", icon: "⚡" },
      { name: "TypeScript", icon: "📘" },
      { name: "React", icon: "⚛️" },
      { name: "Astro", icon: "🚀" },
      { name: "Tailwind CSS", icon: "🎨" },
    ],
  },
  {
    title: "Backend",
    icon: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
    color: "from-violet-400 to-purple-500",
    glowColor: "rgba(167,139,250,0.15)",
    skills: [
      { name: "Node.js", icon: "💚" },
      { name: "PostgreSQL", icon: "🐘" },
      { name: "REST APIs", icon: "🔗" },
      { name: "Git", icon: "🔀" },
      { name: "ASP.NET Core", icon: "🔷" },
    ],
  },
  {
    title: "Herramientas",
    icon: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    color: "from-emerald-400 to-teal-500",
    glowColor: "rgba(52,211,153,0.15)",
    skills: [
      { name: "VS Code", icon: "💻" },
      { name: "Docker", icon: "🐳" },
      { name: "Linux", icon: "🐧" },
      { name: "CI/CD", icon: "🔄" },
    ],
  },
];
---

<section id="habilidades" class="relative overflow-hidden py-24 sm:py-28" aria-labelledby="habilidades-heading">
  <!-- Background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_50%,rgba(56,189,248,0.08),transparent_50%)]" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-motion-reveal class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Stack</p>
      <h2 id="habilidades-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Habilidades</h2>
      <p class="mt-3 text-base leading-relaxed text-slate-300 sm:text-lg">Tecnologías y herramientas que utilizo para construir interfaces y productos sólidos.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((group) => (
        <div
          data-motion-reveal
          class="group relative rounded-3xl border border-slate-700/70 bg-white/[0.03] p-6 shadow-sm backdrop-blur transition-all duration-500 hover:border-sky-400/20 hover:bg-white/[0.05] hover:shadow-lg"
        >
          <!-- Hover gradient overlay -->
          <div
            class="pointer-events-none absolute inset-0 -z-10 rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background: radial-gradient(circle at 50% 0%, rgba(56,189,248,0.08), transparent 70%);"
          ></div>

          <!-- Category header -->
          <div class="mb-5 flex items-center gap-3">
            <div class={`flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br ${group.color} text-white shadow-lg`}>
              <span set:html={group.icon} />
            </div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-white">
              {group.title}
            </h3>
          </div>

          <!-- Interactive skill tiles grid -->
          <div class="grid grid-cols-2 gap-2.5">
            {group.skills.map((skill, i) => (
              <div
                class="skill-tile group/tile relative overflow-hidden rounded-2xl border border-slate-700/50 bg-white/[0.02] p-3 text-center transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/20 hover:bg-white/[0.06] hover:shadow-lg hover:shadow-cyan-500/5"
                style={`transition-delay: ${i * 60}ms; animation-delay: ${i * 60}ms`}
              >
                <!-- Top gradient accent line -->
                <div class={`absolute left-0 right-0 top-0 h-0.5 bg-gradient-to-r ${group.color} scale-x-0 opacity-0 transition-all duration-300 group-hover/tile:scale-x-100 group-hover/tile:opacity-100`}></div>

                <!-- Glow on hover -->
                <div
                  class="pointer-events-none absolute inset-0 -z-10 rounded-2xl opacity-0 transition-opacity duration-300 group-hover/tile:opacity-100"
                  style={`background: radial-gradient(circle at 50% 0%, ${group.glowColor}, transparent 70%);`}
                ></div>

                <!-- Emoji icon -->
                <span class="block text-2xl leading-none">{skill.icon}</span>

                <!-- Skill name -->
                <span class="mt-1.5 block text-xs font-medium text-slate-400 transition-colors duration-200 group-hover/tile:text-slate-200">
                  {skill.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Staggered entrance animation */
  .skill-tile {
    opacity: 0;
    transform: translateY(12px) scale(0.95);
  }

  .skill-tile.in-view {
    animation: tile-enter 0.45s ease-out forwards;
  }

  @keyframes tile-enter {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  import { inView } from "motion";

  // Animate tiles with stagger when each category card enters the viewport
  const cards = document.querySelectorAll(".group");

  cards.forEach((card) => {
    inView(
      card,
      () => {
        const tiles = card.querySelectorAll(".skill-tile");
        tiles.forEach((tile) => {
          tile.classList.add("in-view");
        });
      },
      { margin: "-40px 0px" }
    );
  });
</script>
