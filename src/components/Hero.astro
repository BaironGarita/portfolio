---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;

const stats = [
  { value: "03", label: "Proyectos publicados" },
  { value: "2023", label: "Desde que trabajo con clientes" },
  { value: "CR", label: "Costa Rica · GMT-6" },
  { value: "24–48 h", label: "Tiempo de respuesta" },
];
---

<section
  id="hero"
  class="relative flex min-h-[calc(100svh-var(--header-h))] items-center overflow-hidden pt-[calc(6rem+env(safe-area-inset-top))] pb-16 sm:pb-20"
  aria-labelledby="hero-heading"
>
  <div class="container-page w-full">
    <div
      class="grid items-center gap-14 lg:grid-cols-[1.12fr_0.88fr] lg:gap-16"
    >
      <div class="max-w-2xl">
        <p
          data-reveal-hero
          class="inline-flex items-center gap-2.5 rounded-full border border-mint/25 bg-mint/[0.07] px-3.5 py-1.5 text-xs font-medium tracking-wide text-mint"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-75"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mint"
            ></span>
          </span>
          Disponible para nuevos proyectos
        </p>

        <h1 id="hero-heading" data-reveal-hero class="display mt-7 text-white">
          Interfaces limpias,
          <span
            class="serif-accent gradient-text mt-1 block pb-2 text-[1.06em] leading-[0.86]"
          >
            experiencias fluidas.
          </span>
        </h1>

        <p
          data-reveal-hero
          class="mt-7 max-w-xl text-base leading-8 text-slate-300 sm:text-lg"
        >
          Soy <strong class="font-semibold text-white">{SITE.name}</strong>,
          desarrollador web en Costa Rica. Construyo productos digitales donde
          el diseño, la accesibilidad y el rendimiento van de la mano.
        </p>

        <div
          data-reveal-hero
          class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
        >
          <a
            href={`${base}#proyectos`}
            class="btn btn-primary w-full sm:w-auto"
          >
            Ver proyectos
            <Icon
              name="chevronDown"
              class="icon-nudge icon-nudge-down h-4 w-4"
            />
          </a>
          <a
            href={`${base}#contacto`}
            class="btn btn-secondary w-full sm:w-auto"
          >
            Hablemos de tu idea
          </a>
          <div
            class="flex items-center justify-center gap-2 sm:ml-1 sm:justify-start"
          >
            <a
              href={SITE.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-icon"
              aria-label={`GitHub de ${SITE.name} (se abre en una pestaña nueva)`}
            >
              <Icon name="github" class="h-4 w-4" />
            </a>
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-icon"
              aria-label={`LinkedIn de ${SITE.name} (se abre en una pestaña nueva)`}
            >
              <Icon name="linkedin" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <!-- Tarjeta de perfil: consola + ficha -->
      <aside
        data-reveal-hero
        data-reveal-delay="120"
        class="relative"
        aria-label="Resumen del perfil"
      >
        <div class="profile-card panel overflow-hidden rounded-[1.75rem] p-1.5">
          <div class="rounded-[1.4rem] bg-night/85 p-5 sm:p-6">
            <div class="mb-5 flex items-center justify-between">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/70"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-mint/70"></span>
              </div>
              <p class="font-mono text-[11px] tracking-wider text-slate-400">
                ~/bairon
              </p>
            </div>

            <div
              class="space-y-1.5 font-mono text-[12.5px] leading-6 sm:text-[13px]"
            >
              <p class="text-slate-400">
                <span class="text-mint">$</span> whoami
              </p>
              <p class="text-slate-200">Bairon Garita · Desarrollador Web</p>
              <p class="pt-2 text-slate-400">
                <span class="text-mint">$</span> cat enfoque.txt
              </p>
              <p class="text-slate-300">
                diseño <span class="text-slate-500">→</span> desarrollo
                <span class="text-slate-500">→</span> detalle
              </p>
              <p class="pt-2 text-slate-400">
                <span class="text-mint">$</span> stack --actual
              </p>
              <p class="flex flex-wrap gap-x-2 gap-y-1 text-slate-300">
                <span class="text-sky">astro</span>
                <span class="text-slate-500">·</span>
                <span class="text-sky">react</span>
                <span class="text-slate-500">·</span>
                <span class="text-sky">typescript</span>
                <span class="text-slate-500">·</span>
                <span class="text-sky">tailwind</span>
              </p>
              <p class="pt-2 text-slate-400">
                <span class="text-mint">$</span> echo $EMAIL
              </p>
              <p class="truncate">
                <a
                  href={`mailto:${SITE.email}`}
                  class="text-mint hover:text-white"
                >
                  {SITE.email}
                </a>
              </p>
              <p class="flex items-center gap-2 pt-2 text-slate-400">
                <span
                  class="inline-block h-2 w-1.5 animate-pulse bg-mint"
                  aria-hidden="true"></span>
              </p>
            </div>
          </div>
        </div>

        <div
          class="absolute -top-3 -right-2 rotate-3 rounded-full border border-sky/30 bg-panel/90 px-3 py-1 font-mono text-[11px] tracking-[0.18em] text-sky uppercase shadow-lg backdrop-blur sm:-top-4 sm:right-4"
          aria-hidden="true"
        >
          UX + código
        </div>
      </aside>
    </div>

    <!-- Franja de datos -->
    <dl
      data-reveal
      class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-white/10 pt-8 sm:mt-20 lg:grid-cols-4"
    >
      {
        stats.map((stat) => (
          <div data-reveal-child class="min-w-0">
            <dt class="font-mono text-[11px] tracking-[0.2em] text-slate-400 uppercase">
              {stat.label}
            </dt>
            <dd class="mt-1.5 font-mono text-2xl font-medium tracking-tight text-white sm:text-3xl">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .profile-card {
    position: relative;
    isolation: isolate;
  }

  /* Borde degradado sutil alrededor de la consola */
  .profile-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from 200deg,
      rgba(45, 212, 191, 0.6),
      rgba(56, 189, 248, 0.3),
      rgba(94, 234, 212, 0.35),
      rgba(45, 212, 191, 0.6)
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.75;
  }
</style>
