---
import { getCollection } from 'astro:content';
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    title: entry.data.title,
    summary: entry.data.description,
    tags: entry.data.stack,
    demo: entry.data.url ?? null,
    github: entry.data.repo ?? '#',
    accent: entry.data.accent,
    status: entry.data.status,
  }));
---

<section id="proyectos" class="section" aria-labelledby="proyectos-heading">
  <div class="container-page">
    <SectionHeader
      id="proyectos-heading"
      eyebrow="Portafolio"
      title="Proyectos destacados"
      description="Una selección de trabajos con foco en claridad visual, funcionalidad y experiencia de uso."
    />

    <div class="grid gap-4 sm:gap-5">
      {
        projects.map((project, index) => (
          <article
            data-motion-reveal
            data-reveal-delay={String(index * 90)}
            class="card card-interactive card-spotlight group overflow-hidden p-5 sm:p-7"
          >
            <div
              class={`absolute top-0 left-0 h-full w-1 origin-top scale-y-[0.35] bg-gradient-to-b ${project.accent} opacity-70 transition-[scale,opacity] duration-500 ease-out group-hover:scale-y-100 group-hover:opacity-100`}
              aria-hidden="true"
            />

            <div class="flex flex-col gap-5 pl-2 sm:gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
              <div class="min-w-0 flex-1">
                <div class="mb-3 flex flex-wrap items-center gap-2">
                  <span class="chip tabular-nums text-slate-400">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {project.status === "live" ? (
                    <span class="chip chip-live">
                      <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400" />
                      </span>
                      En vivo
                    </span>
                  ) : (
                    <span class="chip chip-muted">Código abierto</span>
                  )}
                </div>

                <h3 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">{project.title}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-300 sm:mt-3 sm:text-base">
                  {project.summary}
                </p>

                <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.title}`}>
                  {project.tags.map((tag) => (
                    <li class="chip chip-hover">{tag}</li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-col gap-2 sm:flex-row lg:w-40 lg:flex-col lg:shrink-0">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary flex-1 lg:flex-none"
                  >
                    Visitar sitio
                    <Icon name="external" class="icon-nudge h-4 w-4" />
                  </a>
                )}
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary flex-1 lg:flex-none"
                >
                  <Icon name="github" class="icon-nudge h-4 w-4" />
                  Código
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
