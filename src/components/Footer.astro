---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer
  transition:persist
  class="relative overflow-hidden border-t border-white/10"
  role="contentinfo"
>
  <div
    class="pointer-events-none absolute inset-x-0 -bottom-40 h-80 bg-[radial-gradient(ellipse_at_center,rgba(56,189,248,0.12),transparent_65%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative pt-14 pb-10 sm:pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-xs">
        <a
          href={`${base}#hero`}
          class="group inline-flex items-center gap-2.5 text-white"
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-mint via-mint to-sky text-sm font-bold text-night shadow-lg shadow-mint/20"
            aria-hidden="true">B</span
          >
          <span class="text-base font-semibold tracking-tight">
            Bairon<span class="gradient-text">.Dev</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          Desarrollador web en Costa Rica. Interfaces limpias, accesibles y
          rápidas.
        </p>
        <p
          class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] text-mint uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-mint" aria-hidden="true"
          ></span>
          Disponible para proyectos
        </p>
      </div>

      <nav aria-label="Pie de página">
        <p
          class="mb-4 font-mono text-[11px] tracking-[0.22em] text-slate-400 uppercase"
        >
          Navegación
        </p>
        <ul class="space-y-2.5">
          {
            SITE.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="link-underline inline-flex items-center text-sm text-slate-400 hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p
          class="mb-4 font-mono text-[11px] tracking-[0.22em] text-slate-400 uppercase"
        >
          Conectar
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="link-underline block text-sm font-medium break-all text-slate-300 hover:text-white"
        >
          {SITE.email}
        </a>
        <div class="mt-5 flex gap-2">
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label="GitHub (se abre en una pestaña nueva)"
          >
            <Icon name="github" class="h-4 w-4" />
          </a>
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label="LinkedIn (se abre en una pestaña nueva)"
          >
            <Icon name="linkedin" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- Wordmark -->
    <div class="mt-14 sm:mt-16">
      <p
        class="serif-accent gradient-text text-[clamp(3rem,12vw,8.5rem)] leading-[0.85] tracking-tight select-none"
        aria-hidden="true"
      >
        Bairon Garita
      </p>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[11px] tracking-wide text-slate-400">
        &copy; {year}
        {SITE.name} — Astro + Tailwind
      </p>
      <a
        href={`${base}#hero`}
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-white"
      >
        Volver arriba
        <Icon
          name="chevronUp"
          class="h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</footer>
