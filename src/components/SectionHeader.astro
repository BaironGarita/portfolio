---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div data-motion-reveal data-reveal-stagger class="section-header">
  <p data-reveal-child class="section-eyebrow">{eyebrow}</p>
  <h2 data-reveal-child id={id} class="section-title">{title}</h2>
  {description && <p data-reveal-child class="section-desc">{description}</p>}
</div>
