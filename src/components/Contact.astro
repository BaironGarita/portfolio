---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";

const channels = [
  {
    label: "Email",
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    icon: "mail" as const,
    external: false,
    copy: true,
    accent: "from-mint to-sky",
  },
  {
    label: "GitHub",
    value: "@BaironGarita",
    href: SITE.social.github,
    icon: "github" as const,
    external: true,
    accent: "from-slate-400 to-slate-600",
  },
  {
    label: "LinkedIn",
    value: "/in/bairongarita",
    href: SITE.social.linkedin,
    icon: "linkedin" as const,
    external: true,
    accent: "from-sky to-sky-600",
  },
];
---

<section
  id="contacto"
  class="section relative overflow-hidden"
  aria-labelledby="contacto-heading"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-0 left-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/3 rounded-full bg-mint/10 blur-3xl"
    >
    </div>
  </div>

  <div class="container-page">
    <div
      data-reveal
      class="panel grid gap-10 p-6 sm:p-9 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14 lg:p-12"
    >
      <div>
        <p class="eyebrow">04 — Contacto</p>
        <h2 id="contacto-heading" class="display-lg mt-6 text-white">
          ¿Tienes una idea?<br />
          <span class="serif-accent gradient-text pb-1">Hagámosla real.</span>
        </h2>
        <p class="section-desc">
          Cuéntame qué necesitas y te respondo con un plan claro: alcance,
          tiempos y siguiente paso.
        </p>

        <div class="mt-8 space-y-2.5 sm:space-y-3">
          {
            channels.map((ch) => {
              const rowInner = (
                <>
                  <div
                    class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${ch.accent} text-white shadow-md transition-transform duration-300 ease-out group-hover:scale-110`}
                    aria-hidden="true"
                  >
                    <Icon name={ch.icon} class="h-4 w-4" />
                  </div>
                  <div class="min-w-0">
                    <p class="font-mono text-[11px] tracking-[0.2em] text-slate-400 uppercase">
                      {ch.label}
                    </p>
                    <p class="truncate text-sm font-medium text-slate-200 group-hover:text-white">
                      {ch.value}
                    </p>
                  </div>
                </>
              );
              return ch.copy ? (
                <div class="card-link flex items-center gap-3 p-3.5 sm:p-4">
                  <a
                    href={ch.href}
                    class="group flex min-w-0 flex-1 items-center gap-3"
                  >
                    {rowInner}
                  </a>
                  <button
                    type="button"
                    data-copy-email
                    class="btn btn-ghost btn-icon shrink-0"
                    aria-label="Copiar email"
                    title="Copiar email"
                  >
                    <span data-copy-icon class="contents">
                      <Icon name="copy" class="h-4 w-4" />
                    </span>
                    <span data-copy-ok class="hidden">
                      <Icon name="check" class="h-4 w-4 text-mint" />
                    </span>
                  </button>
                </div>
              ) : (
                <a
                  href={ch.href}
                  target={ch.external ? "_blank" : undefined}
                  rel={ch.external ? "noopener noreferrer" : undefined}
                  class="card-link group flex items-center gap-3 p-3.5 sm:p-4"
                >
                  {rowInner}
                  <span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              );
            })
          }
        </div>

        <p class="mt-5 text-xs leading-relaxed text-slate-400 sm:mt-6">
          Tiempo de respuesta habitual: 24–48 h en días laborables.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-night/50 p-5 sm:p-7">
        <h3 class="mb-1 text-lg font-semibold tracking-tight text-white">
          Envíame un mensaje
        </h3>
        <p class="mb-5 text-sm text-slate-400 sm:mb-6">
          Completa el formulario y se abrirá tu cliente de correo con el mensaje
          listo.
        </p>

        <form
          id="contact-form"
          class="space-y-4"
          novalidate
          data-email={SITE.email}
        >
          <div>
            <label for="form-name" class="field-label">
              Nombre <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
              aria-required="true"
              aria-describedby="name-error"
              class="field"
            />
            <p id="name-error" class="field-error" hidden role="alert">
              El nombre es obligatorio
            </p>
          </div>

          <div>
            <label for="form-email" class="field-label">
              Email <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="tu@email.com"
              aria-required="true"
              aria-describedby="email-error"
              class="field"
            />
            <p id="email-error" class="field-error" hidden role="alert">
              Ingresa un email válido
            </p>
          </div>

          <div>
            <label for="form-subject" class="field-label">
              Asunto <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-subject"
              name="subject"
              type="text"
              required
              placeholder="¿De qué se trata?"
              aria-required="true"
              aria-describedby="subject-error"
              class="field"
            />
            <p id="subject-error" class="field-error" hidden role="alert">
              El asunto es obligatorio
            </p>
          </div>

          <div>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <label for="form-message" class="field-label mb-0">
                Mensaje <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <span
                id="message-count"
                class="text-xs text-slate-400 tabular-nums">0 / 10 mín.</span
              >
            </div>
            <textarea
              id="form-message"
              name="message"
              required
              rows="4"
              minlength="10"
              placeholder="Cuéntame sobre tu proyecto..."
              aria-required="true"
              aria-describedby="message-error message-count"
              class="field min-h-[6.5rem] resize-y"></textarea>
            <p id="message-error" class="field-error" hidden role="alert">
              El mensaje debe tener al menos 10 caracteres
            </p>
          </div>

          <p class="text-xs leading-relaxed text-slate-400">
            El formulario no guarda datos: prepara el mensaje y abre tu
            aplicación de correo para que lo envíes tú.
          </p>

          <button
            id="form-submit"
            type="submit"
            class="btn btn-primary btn-block"
          >
            <span id="submit-text">Abrir en mi correo</span>
            <Icon name="arrowRight" class="icon-nudge h-4 w-4" />
          </button>

          <div
            id="form-success"
            class="hidden items-start gap-3 rounded-xl border border-mint/20 bg-mint/5 px-4 py-3 text-sm text-mint"
            role="status"
            aria-live="polite"
          >
            <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-mint" />
            <span>
              Abrimos tu cliente de correo con el mensaje listo. Si no se abrió,
              escríbeme directamente a
              <a
                href={`mailto:${SITE.email}`}
                class="font-medium underline underline-offset-2 hover:text-white"
              >
                {SITE.email}
              </a>.
            </span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script data-astro-rerun>
  (() => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const fields = {
      name: {
        input: document.getElementById("form-name"),
        error: document.getElementById("name-error"),
        validate: (v) => v.length > 0,
      },
      email: {
        input: document.getElementById("form-email"),
        error: document.getElementById("email-error"),
        validate: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
      },
      subject: {
        input: document.getElementById("form-subject"),
        error: document.getElementById("subject-error"),
        validate: (v) => v.length > 0,
      },
      message: {
        input: document.getElementById("form-message"),
        error: document.getElementById("message-error"),
        validate: (v) => v.length >= 10,
      },
    };

    const messageCount = document.getElementById("message-count");
    const successMsg = document.getElementById("form-success");

    function setInvalid(input, error, invalid) {
      if (!input || !error) return;
      input.setAttribute("aria-invalid", String(invalid));
      error.hidden = !invalid;
    }

    function validateField({ input, error, validate }) {
      if (!input || !error) return false;
      const value = input.value.trim();
      const ok = validate(value);
      setInvalid(input, error, !ok);
      return ok;
    }

    fields.message.input?.addEventListener("input", () => {
      const len = fields.message.input.value.trim().length;
      if (!messageCount) return;
      messageCount.textContent =
        len < 10 ? `${len} / 10 mín.` : `${len} caracteres`;
      messageCount.classList.toggle("text-mint/80", len >= 10);
      messageCount.classList.toggle("text-slate-400", len < 10);
    });

    Object.values(fields).forEach((field) => {
      field.input?.addEventListener("blur", () => validateField(field));
      field.input?.addEventListener("input", () => {
        if (field.input?.getAttribute("aria-invalid") === "true") {
          setInvalid(field.input, field.error, false);
        }
      });
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const results = Object.values(fields).map(validateField);
      if (results.some((ok) => !ok)) {
        const first = Object.values(fields).find(
          (f) => f.input?.getAttribute("aria-invalid") === "true",
        );
        first?.input?.focus();
        // Shake the first invalid field so the problem is impossible to miss
        if (first?.input) {
          first.input.classList.remove("shake");
          void first.input.offsetWidth; // restart the animation
          first.input.classList.add("shake");
        }
        return;
      }

      const name = fields.name.input.value.trim();
      const email = fields.email.input.value.trim();
      const subject = fields.subject.input.value.trim();
      const message = fields.message.input.value.trim();
      const ownerEmail = form.getAttribute("data-email") || "";

      const mailto = `mailto:${ownerEmail}?subject=${encodeURIComponent(`[Portfolio] ${subject}`)}&body=${encodeURIComponent(
        `Nombre: ${name}\nEmail: ${email}\n\n${message}`,
      )}`;

      // The form is a mailto composer, not a stored submission: keep the values so
      // the user can retry, and show a persistent status with a direct fallback.
      window.location.href = mailto;

      if (successMsg) {
        successMsg.classList.remove("hidden");
        successMsg.classList.add("flex");
      }
    });

    // Clean up the shake class once it has played
    form.addEventListener("animationend", (e) => {
      if (
        e.target instanceof HTMLElement &&
        e.target.classList.contains("shake")
      ) {
        e.target.classList.remove("shake");
      }
    });

    // Copy email to clipboard with visual feedback
    const copyBtn = document.querySelector("[data-copy-email]");
    const copyIcon = document.querySelector("[data-copy-icon]");
    const copyOk = document.querySelector("[data-copy-ok]");
    let copyTimer = 0;

    if (copyBtn) {
      const showCopied = () => {
        copyIcon?.classList.add("hidden");
        copyOk?.classList.remove("hidden");
        copyBtn.setAttribute("aria-label", "Email copiado");
        clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          copyOk?.classList.add("hidden");
          copyBtn.setAttribute("aria-label", "Copiar email");
        }, 1600);
      };

      copyBtn.addEventListener("click", async () => {
        const email = form.getAttribute("data-email") || "";
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          showCopied();
        } catch {
          // Sin Clipboard API (contexto no seguro o navegador antiguo) el
          // enlace mailto del propio canal sigue siendo la vía directa.
          window.location.href = `mailto:${email}`;
        }
      });
    }
  })();
</script>
