---
import { technologies } from "../data/skills";
---

<section
  class="tech-band border-y border-white/8 bg-night/40"
  aria-label="Tecnologías utilizadas"
>
  <div class="container-page overflow-hidden py-5 sm:py-6">
    <div class="flex items-center gap-5 sm:gap-8">
      <p
        class="shrink-0 text-xs font-semibold tracking-[0.2em] text-mint uppercase"
      >
        Tecnologías
      </p>
      <!-- Decorativo: la lista accesible va después, sin duplicados -->
      <div class="min-w-0 overflow-hidden" aria-hidden="true">
        <div class="tech-band-track">
          {
            [...technologies, ...technologies].map((technology) => (
              <span class="tech-band-item">{technology}</span>
            ))
          }
        </div>
      </div>
      <ul class="sr-only">
        {technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .tech-band-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.75rem;
    animation: tech-band-scroll 32s linear infinite;
    will-change: transform;
  }

  .tech-band-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid rgb(45 212 191 / 0.18);
    border-radius: 9999px;
    padding: 0.45rem 0.85rem;
    color: rgb(242 244 248 / 0.9);
    background: rgb(255 255 255 / 0.035);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .tech-band {
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 6%,
      black 94%,
      transparent
    );
  }

  @keyframes tech-band-scroll {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-band-track {
      animation: none;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tech-band-item:nth-child(n + 17) {
      display: none;
    }
  }
</style>
