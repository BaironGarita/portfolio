---
import { SITE } from "../site.config";
---

<section id="contacto" class="relative overflow-hidden py-24 sm:py-28" aria-labelledby="contacto-heading">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-motion-reveal class="grid gap-8 rounded-3xl border border-sky-400/15 bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950/80 px-6 py-10 shadow-[0_20px_60px_-35px_rgba(2,6,23,0.8)] backdrop-blur-sm sm:px-8 lg:grid-cols-[1fr_1.2fr] lg:gap-12 lg:px-10">
      <!-- Info column -->
      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Contacto</p>
        <h2 id="contacto-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
          ¿Tienes una idea o proyecto en mente?
        </h2>
        <p class="mt-3 text-base leading-relaxed text-slate-300">
          Me encantaría escuchar sobre él y ayudarte a convertirlo en una experiencia clara, rápida y útil.
        </p>

        <div class="mt-8 space-y-3">
          <a
            href={`mailto:${SITE.email}`}
            class="group flex items-center gap-3 rounded-2xl border border-slate-700/50 bg-white/[0.02] p-4 transition-all duration-300 hover:border-sky-400/20 hover:bg-white/[0.05]"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-white shadow-lg" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-medium text-slate-400">Email</p>
              <p class="truncate text-sm font-medium text-slate-200 transition-colors group-hover:text-white">{SITE.email}</p>
            </div>
          </a>

          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 rounded-2xl border border-slate-700/50 bg-white/[0.02] p-4 transition-all duration-300 hover:border-sky-400/20 hover:bg-white/[0.05]"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-slate-400 to-slate-600 text-white shadow-lg" aria-hidden="true">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400">GitHub</p>
              <p class="text-sm font-medium text-slate-200 transition-colors group-hover:text-white">@BaironGarita</p>
            </div>
          </a>

          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 rounded-2xl border border-slate-700/50 bg-white/[0.02] p-4 transition-all duration-300 hover:border-sky-400/20 hover:bg-white/[0.05]"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-lg" aria-hidden="true">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400">LinkedIn</p>
              <p class="text-sm font-medium text-slate-200 transition-colors group-hover:text-white">/in/bairongarita</p>
            </div>
          </a>
        </div>

        <p class="mt-6 text-xs leading-relaxed text-slate-500">
          Tiempo de respuesta habitual: 24–48 h en días laborables.
        </p>
      </div>

      <!-- Form column -->
      <div class="rounded-2xl border border-slate-700/50 bg-white/[0.02] p-6 sm:p-8">
        <h3 class="mb-1 text-lg font-semibold text-white">Envíame un mensaje</h3>
        <p class="mb-6 text-sm text-slate-400">
          Completa el formulario y se abrirá tu cliente de correo con el mensaje listo para enviar.
        </p>

        <form id="contact-form" class="space-y-4" novalidate data-email={SITE.email} aria-describedby="form-hint">
          <p id="form-hint" class="sr-only">
            Todos los campos marcados con asterisco son obligatorios. Al enviar se abrirá tu aplicación de correo.
          </p>

          <!-- Name -->
          <div>
            <label for="form-name" class="mb-1.5 block text-sm font-medium text-slate-300">
              Nombre <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
              aria-required="true"
              aria-describedby="name-error"
              class="w-full rounded-xl border border-slate-700/70 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all duration-200 focus:border-sky-400/50 focus:bg-white/[0.05] focus:ring-2 focus:ring-sky-400/20"
            />
            <p id="name-error" class="mt-1.5 hidden text-xs text-red-400" role="alert">El nombre es obligatorio</p>
          </div>

          <!-- Email -->
          <div>
            <label for="form-email" class="mb-1.5 block text-sm font-medium text-slate-300">
              Email <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="tu@email.com"
              aria-required="true"
              aria-describedby="email-error"
              class="w-full rounded-xl border border-slate-700/70 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all duration-200 focus:border-sky-400/50 focus:bg-white/[0.05] focus:ring-2 focus:ring-sky-400/20"
            />
            <p id="email-error" class="mt-1.5 hidden text-xs text-red-400" role="alert">Ingresa un email válido</p>
          </div>

          <!-- Subject -->
          <div>
            <label for="form-subject" class="mb-1.5 block text-sm font-medium text-slate-300">
              Asunto <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="form-subject"
              name="subject"
              type="text"
              required
              placeholder="¿De qué se trata?"
              aria-required="true"
              aria-describedby="subject-error"
              class="w-full rounded-xl border border-slate-700/70 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all duration-200 focus:border-sky-400/50 focus:bg-white/[0.05] focus:ring-2 focus:ring-sky-400/20"
            />
            <p id="subject-error" class="mt-1.5 hidden text-xs text-red-400" role="alert">El asunto es obligatorio</p>
          </div>

          <!-- Message -->
          <div>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <label for="form-message" class="block text-sm font-medium text-slate-300">
                Mensaje <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <span id="message-count" class="text-xs tabular-nums text-slate-500" aria-live="polite">0 / 10 mín.</span>
            </div>
            <textarea
              id="form-message"
              name="message"
              required
              rows="4"
              minlength="10"
              placeholder="Cuéntame sobre tu proyecto..."
              aria-required="true"
              aria-describedby="message-error message-count"
              class="w-full resize-y rounded-xl border border-slate-700/70 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all duration-200 focus:border-sky-400/50 focus:bg-white/[0.05] focus:ring-2 focus:ring-sky-400/20"
            ></textarea>
            <p id="message-error" class="mt-1.5 hidden text-xs text-red-400" role="alert">El mensaje debe tener al menos 10 caracteres</p>
          </div>

          <!-- Submit -->
          <button
            id="form-submit"
            type="submit"
            class="group relative inline-flex w-full items-center justify-center gap-2 overflow-hidden rounded-full bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-600 px-6 py-3.5 text-sm font-medium text-slate-950 shadow-lg shadow-cyan-500/20 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-cyan-400/30 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0"
          >
            <span id="submit-text">Preparar mensaje</span>
            <svg id="submit-icon" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
          </button>

          <!-- Success / info message -->
          <div
            id="form-success"
            class="hidden items-center gap-3 rounded-xl border border-emerald-400/20 bg-emerald-400/5 px-4 py-3 text-sm text-emerald-200"
            role="status"
            aria-live="polite"
          >
            <svg class="h-5 w-5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Se abrió tu cliente de correo. Solo confirma el envío y te responderé pronto.</span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const submitBtn = document.getElementById("form-submit");
  const submitText = document.getElementById("submit-text");
  const submitIcon = document.getElementById("submit-icon");
  const submitSpinner = document.getElementById("submit-spinner");
  const successMsg = document.getElementById("form-success");
  const messageCount = document.getElementById("message-count");

  const nameInput = document.getElementById("form-name");
  const emailInput = document.getElementById("form-email");
  const subjectInput = document.getElementById("form-subject");
  const messageInput = document.getElementById("form-message");

  const nameError = document.getElementById("name-error");
  const emailError = document.getElementById("email-error");
  const subjectError = document.getElementById("subject-error");
  const messageError = document.getElementById("message-error");

  function showError(el, input) {
    el?.classList.remove("hidden");
    input?.setAttribute("aria-invalid", "true");
  }

  function hideError(el, input) {
    el?.classList.add("hidden");
    input?.removeAttribute("aria-invalid");
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validateField(input, errorEl, validator) {
    if (!input || !errorEl) return false;
    const value = input.value.trim();
    if (!value || (validator && !validator(value))) {
      input.classList.add("border-red-400/50", "focus:border-red-400/50", "focus:ring-red-400/20");
      input.classList.remove("focus:border-sky-400/50", "focus:ring-sky-400/20");
      showError(errorEl, input);
      return false;
    }
    input.classList.remove("border-red-400/50", "focus:border-red-400/50", "focus:ring-red-400/20");
    input.classList.add("focus:border-sky-400/50", "focus:ring-sky-400/20");
    hideError(errorEl, input);
    return true;
  }

  // Character counter
  messageInput?.addEventListener("input", () => {
    const len = messageInput.value.trim().length;
    if (messageCount) {
      messageCount.textContent = len < 10 ? `${len} / 10 mín.` : `${len} caracteres`;
      messageCount.classList.toggle("text-emerald-400/80", len >= 10);
      messageCount.classList.toggle("text-slate-500", len < 10);
    }
  });

  // Real-time validation on blur
  nameInput?.addEventListener("blur", () => validateField(nameInput, nameError));
  emailInput?.addEventListener("blur", () => validateField(emailInput, emailError, validateEmail));
  subjectInput?.addEventListener("blur", () => validateField(subjectInput, subjectError));
  messageInput?.addEventListener("blur", () =>
    validateField(messageInput, messageError, (v) => v.length >= 10)
  );

  // Clear error while typing after a failed submit
  [nameInput, emailInput, subjectInput, messageInput].forEach((input) => {
    input?.addEventListener("input", () => {
      if (input.getAttribute("aria-invalid") === "true") {
        input.classList.remove("border-red-400/50");
      }
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const isNameValid = validateField(nameInput, nameError);
    const isEmailValid = validateField(emailInput, emailError, validateEmail);
    const isSubjectValid = validateField(subjectInput, subjectError);
    const isMessageValid = validateField(messageInput, messageError, (v) => v.length >= 10);

    if (!isNameValid || !isEmailValid || !isSubjectValid || !isMessageValid) {
      // Focus first invalid field
      const firstInvalid = [nameInput, emailInput, subjectInput, messageInput].find(
        (el) => el?.getAttribute("aria-invalid") === "true"
      );
      firstInvalid?.focus();
      return;
    }

    if (!submitBtn || !submitText || !submitIcon || !submitSpinner || !successMsg) return;

    submitBtn.disabled = true;
    submitText.textContent = "Preparando...";
    submitIcon.classList.add("hidden");
    submitSpinner.classList.remove("hidden");

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const subject = subjectInput.value.trim();
    const message = messageInput.value.trim();

    const ownerEmail = form.getAttribute("data-email") || "ingbairongarita@gmail.com";
    const mailtoSubject = encodeURIComponent(`[Portfolio] ${subject}`);
    const mailtoBody = encodeURIComponent(`Nombre: ${name}\nEmail: ${email}\n\n${message}`);

    await new Promise((resolve) => setTimeout(resolve, 600));

    window.location.href = `mailto:${ownerEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

    form.reset();
    if (messageCount) messageCount.textContent = "0 / 10 mín.";
    submitBtn.disabled = false;
    submitText.textContent = "Preparar mensaje";
    submitIcon.classList.remove("hidden");
    submitSpinner.classList.add("hidden");

    successMsg.classList.remove("hidden");
    successMsg.classList.add("flex");

    setTimeout(() => {
      successMsg.classList.add("hidden");
      successMsg.classList.remove("flex");
    }, 6000);
  });
</script>
