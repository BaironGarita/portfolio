type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  id?: string;
}

const { name, class: className = "h-4 w-4", id } = Astro.props;
const icon = icons[name];
---

{
  icon.filled ? (
    <svg id={id} class={className} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : (
    <svg id={id} class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      {icon.paths.map((d) => (
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={d} />
      ))}
    </svg>
  )
}
