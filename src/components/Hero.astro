---
import { SITE } from "../site.config";
import Icon from "./Icon.astro";
---

<section
  id="hero"
  class="relative overflow-hidden pt-[calc(5.5rem+env(safe-area-inset-top))] sm:pt-28"
  aria-labelledby="hero-heading"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.07)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_30%,black,transparent)]"
    >
    </div>
    <div data-motion-orb class="absolute top-16 left-[-6rem] h-64 w-64 rounded-full bg-cyan-400/12 blur-3xl sm:h-72 sm:w-72"></div>
    <div data-motion-orb class="absolute top-0 right-0 h-72 w-72 rounded-full bg-blue-500/12 blur-3xl sm:h-96 sm:w-96"></div>
  </div>

  <div class="container-page grid gap-10 pb-16 sm:gap-12 sm:pb-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:py-16">
    <div class="max-w-2xl">
      <p
        data-motion-hero
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-sky-200 backdrop-blur"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        Disponible para colaborar
      </p>

      <h1 id="hero-heading" data-motion-hero class="mb-5 text-[2rem] font-bold tracking-tight text-white sm:mb-6 sm:text-5xl lg:text-6xl">
        Interfaces limpias,
        <span class="text-gradient-animate mt-1 block bg-gradient-to-r from-cyan-300 via-sky-400 to-blue-500 bg-clip-text text-transparent">
          experiencias fluidas.
        </span>
      </h1>

      <p data-motion-hero class="mb-8 max-w-xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">
        Soy <strong class="font-semibold text-white">{SITE.name}</strong>, desarrollador web enfocado en productos
        claros, fáciles de usar y mantenibles.
      </p>

      <div data-motion-hero class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a href="#proyectos" class="btn btn-primary w-full sm:w-auto">
          Ver proyectos
          <Icon name="chevronDown" class="icon-nudge icon-nudge-down h-4 w-4" />
        </a>
        <a href="#contacto" class="btn btn-secondary w-full sm:w-auto">Hablar de un proyecto</a>
        <div class="flex items-center justify-center gap-2 sm:justify-start sm:pl-1">
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label={`GitHub de ${SITE.name}`}
          >
            <Icon name="github" class="h-4 w-4" />
          </a>
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-icon"
            aria-label={`LinkedIn de ${SITE.name}`}
          >
            <Icon name="linkedin" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>

    <aside data-motion-hero class="card card-spotlight p-5 sm:p-6" aria-label="Resumen del perfil">
      <div class="mb-5 flex items-start justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-slate-400">Perfil</p>
          <h2 class="text-lg font-semibold text-white sm:text-xl">Diseño + desarrollo</h2>
        </div>
        <span class="chip chip-live shrink-0">UX focused</span>
      </div>

      <ul class="space-y-2.5 sm:space-y-3">
        <li class="rounded-2xl border border-white/5 bg-white/[0.04] p-3.5 sm:p-4">
          <p class="text-xs font-semibold tracking-[0.15em] text-sky-300 uppercase">Enfoque</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">
            Interfaces claras, navegación simple y jerarquía visual sólida.
          </p>
        </li>
        <li class="rounded-2xl border border-white/5 bg-white/[0.04] p-3.5 sm:p-4">
          <p class="text-xs font-semibold tracking-[0.15em] text-cyan-300 uppercase">Valor</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">
            Componentes consistentes y soluciones pensadas para crecer.
          </p>
        </li>
        <li class="rounded-2xl border border-white/5 bg-white/[0.04] p-3.5 sm:p-4">
          <p class="text-xs font-semibold tracking-[0.15em] text-fuchsia-300 uppercase">Contacto</p>
          <a
            class="mt-1 inline-flex text-sm font-medium break-all text-sky-300 hover:text-white"
            href={`mailto:${SITE.email}`}
          >
            {SITE.email}
          </a>
        </li>
      </ul>
    </aside>
  </div>
</section>
